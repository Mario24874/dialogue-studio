# =====================================================
# DIALOGHI STUDIO - Variables de entorno
# Copia este archivo como .env.local y completa los valores
# =====================================================

# ─── Clerk (compartido con italianto.com e italiantoapp-next) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
# Redirecciones post-auth (con basePath /studio incluido)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/studio/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/studio/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/studio
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/studio

# ─── Supabase (compartido con italianto.com e italiantoapp-next) ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Stripe (LIVE - pagos reales) ───
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ESSENZIALE=prod_...
STRIPE_PRODUCT_AVANZATO=prod_...
STRIPE_PRODUCT_MAESTRO=prod_...
STRIPE_PRICE_ESSENZIALE_MONTHLY=price_...
STRIPE_PRICE_ESSENZIALE_ANNUAL=price_...
STRIPE_PRICE_AVANZATO_MONTHLY=price_...
STRIPE_PRICE_AVANZATO_ANNUAL=price_...
STRIPE_PRICE_MAESTRO_MONTHLY=price_...
STRIPE_PRICE_MAESTRO_ANNUAL=price_...

# ─── IA ───
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=sk_...
TRANSLATION_MODE=live

# ─── App ───
# La URL raíz (sin /studio) — Next.js añade el basePath automáticamente
NEXT_PUBLIC_APP_URL=https://italianto.com
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://italianto.com/app
ADMIN_EMAILS=tu@email.com
CRON_SECRET=genera-con-openssl-rand-hex-32
